# Frontend Environment Configuration Example

# Optional Custom Basemap Tile URL (defaults to CartoDB Dark Matter raster tiles)
# Example: https://{s}.basemaps.cartocdn.com/rastertiles/dark_all/{z}/{x}/{y}{r}.png
# Example (Esri Dark Gray): https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/dark_all/{z}/{x}/{y}{r}.png
