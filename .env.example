# NASA FIRMS API Key (Get a free key at https://firms.modaps.eosdis.nasa.gov/api/map_key)
FIRMS_MAP_KEY=fd1aa1c498b6ba1e4ed04024872d1b60
# Default FIRMS Settings
FIRMS_SOURCE=VIIRS_SNPP_NRT
# Area format: west,south,east,north (Default bounding box: India region 68.0, 6.0, 97.0, 37.0 or 'world')
FIRMS_AREA=68.0,6.0,97.0,37.0
FIRMS_DAYS=1

# PostgreSQL / PostGIS Database Configuration
POSTGRES_USER=firms_user
POSTGRES_PASSWORD=firms_password
POSTGRES_DB=firms_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://firms_user:firms_password@localhost:5432/firms_db

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
